{
  "version": 2,
  "builds": [
    {
      "src": "backend/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "frontend/public/**/*",
      "use": "@vercel/static"
    },
    {
      "src": "frontend/src/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend/index.js"
    },
    {
      "src": "/(styles|css)/(.*)",
      "dest": "frontend/src/styles/$2"
    },
    {
      "src": "/src/(.*)",
      "dest": "frontend/src/$1"
    },
    {
      "src": "/(assets|pages)/(.*)",
      "dest": "frontend/public/$1/$2"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "frontend/public/index.html"
    }
  ]
}
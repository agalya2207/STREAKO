{
  "functions": {
    "api/index.js": {
      "includeFiles": "backend/**"
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index.js"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/styles/:path*",
      "destination": "/frontend/src/styles/:path*"
    },
    {
      "source": "/css/:path*",
      "destination": "/frontend/src/styles/:path*"
    },
    {
      "source": "/src/:path*",
      "destination": "/frontend/src/:path*"
    },
    {
      "source": "/assets/:path*",
      "destination": "/frontend/public/assets/:path*"
    },
    {
      "source": "/pages/:path*",
      "destination": "/frontend/public/pages/:path*"
    },
    {
      "source": "/sw.js",
      "destination": "/frontend/public/sw.js"
    },
    {
      "source": "/:path*",
      "destination": "/frontend/public/index.html"
    }
  ]
}
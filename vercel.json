{
  "version": 2,
  "builds": [
    {
      "src": "streako-backend/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "streako-backend/public/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "streako-backend/index.js"
    },
    {
      "src": "/(css|js|assets|pages)/(.*)",
      "dest": "streako-backend/public/$1/$2"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "streako-backend/public/index.html"
    }
  ]
}